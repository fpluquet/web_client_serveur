@baseUrl = http://localhost:3000
@token = 

# Après register ou login, copier data.token dans @token ci-dessus.
# Pour tester les routes admin : dans le JSON des utilisateurs, passer role à "admin",
# puis se reconnecter et mettre à jour @token.

# =============================================================================
# RACINE
# =============================================================================
###
GET {{baseUrl}}/

# =============================================================================
# AUTHENTIFICATION
# =============================================================================
###
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "johndoe",
  "email": "john@example.com",
  "password": "Password123"
}
###
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "janedoe",
  "email": "john@example.com",
  "password": "Password123"
}
###
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "john@example.com",
  "password": "Password123"
}
###
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "email": "john@example.com",
  "password": "WrongPassword"
}

# =============================================================================
# PROFIL UTILISATEUR (Bearer requis)
# =============================================================================
###
GET {{baseUrl}}/api/users/profile
Authorization: Bearer {{token}}
###
PUT {{baseUrl}}/api/users/profile
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "username": "johndoe_updated",
  "email": "john.updated@example.com"
}

# =============================================================================
# ADMIN — liste des utilisateurs (Bearer + role admin)
# =============================================================================
###
GET {{baseUrl}}/api/users
Authorization: Bearer {{token}}
###
GET {{baseUrl}}/api/users?page=1&limit=5
Authorization: Bearer {{token}}
###
GET {{baseUrl}}/api/users?page=2&limit=5
Authorization: Bearer {{token}}

# =============================================================================
# ERREURS D'ACCÈS
# =============================================================================
###
GET {{baseUrl}}/api/users/profile
###
GET {{baseUrl}}/api/users
Authorization: Bearer {{token}}

# =============================================================================
# VALIDATION DES DONNÉES
# =============================================================================
###
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "invalid-email",
  "password": "Password123"
}
###
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "test@example.com",
  "password": "short"
}
###
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "username": "ab",
